      <link name="marker"><visual name="visual"><geometry><box><size>.5 .5 .004</size></box></geometry>
      <material><ambient>0.2 0.6 0.9 1</ambient><diffuse>0.2 0.6 0.9 1</diffuse></material></visual></link></model>
