<?xml version="1.0"?><sdf version="1.9"><world name="inspection">
  <physics name="default_physics" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.8 0.85 0.9 1</background><shadows>false</shadows></scene>
  <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular><direction>-0.5 0.1 -0.9</direction><cast_shadows>false</cast_shadows></light>
  <model name="ground"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
  <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link></model>
<model name="west_wall"><static>true</static><pose>-5 0 0.5 0 0 0</pose>
      <link name="body"><collision name="collision"><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
      <sensor name="obstacle_contact" type="contact"><always_on>true</always_on>
        <contact><collision>collision</collision><topic>/pai/contacts/west_wall</topic></contact></sensor>
      <visual name="visual"><geometry><box><size>0.2 8.2 1</size></box></geometry>
      <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
<model name="east_wall"><static>true</static><pose>5 0 0.5 0 0 0</pose>
      <link name="body"><collision name="collision"><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
      <sensor name="obstacle_contact" type="contact"><always_on>true</always_on>
        <contact><collision>collision</collision><topic>/pai/contacts/east_wall</topic></contact></sensor>
      <visual name="visual"><geometry><box><size>0.2 8.2 1</size></box></geometry>
      <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
<model name="south_wall"><static>true</static><pose>0 -4 0.5 0 0 0</pose>
      <link name="body"><collision name="collision"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <sensor name="obstacle_contact" type="contact"><always_on>true</always_on>
        <contact><collision>collision</collision><topic>/pai/contacts/south_wall</topic></contact></sensor>
      <visual name="visual"><geometry><box><size>10.2 0.2 1</size></box></geometry>
      <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
<model name="north_wall"><static>true</static><pose>0 4 0.5 0 0 0</pose>
      <link name="body"><collision name="collision"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <sensor name="obstacle_contact" type="contact"><always_on>true</always_on>
        <contact><collision>collision</collision><topic>/pai/contacts/north_wall</topic></contact></sensor>
      <visual name="visual"><geometry><box><size>10.2 0.2 1</size></box></geometry>
      <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
<model name="central_obstacle"><static>true</static><pose>0 0 0.5 0 0 0</pose>
      <link name="body"><collision name="collision"><geometry><box><size>1.4 1.4 1</size></box></geometry></collision>
      <sensor name="obstacle_contact" type="contact"><always_on>true</always_on>
        <contact><collision>collision</collision><topic>/pai/contacts/central_obstacle</topic></contact></sensor>
      <visual name="visual"><geometry><box><size>1.4 1.4 1</size></box></geometry>
      <material><ambient>0.25 0.35 0.5 1</ambient><diffuse>0.25 0.35 0.5 1</diffuse></material></visual></link></model>
<model name="station_a_panel"><static>true</static><pose>4 -2 0.15 0 0 0</pose>
      <link name="panel"><visual name="frame"><geometry><box><size>.03 .56 .32</size></box></geometry>
        <material><ambient>.08 .08 .08 1</ambient><diffuse>.08 .08 .08 1</diffuse></material></visual>
      <visual name="indicator"><pose>-.02 0 0 0 0 0</pose><geometry><box><size>.012 .46 .24</size></box></geometry>
        <material><ambient>.45 .45 .45 1</ambient><diffuse>.45 .45 .45 1</diffuse><emissive>.1 .1 .1 1</emissive></material></visual>
      </link></model>
<model name="station_b_panel"><static>true</static><pose>3 3 0.15 0 0 1.5707963267948966</pose>
      <link name="panel"><visual name="frame"><geometry><box><size>.03 .56 .32</size></box></geometry>
        <material><ambient>.08 .08 .08 1</ambient><diffuse>.08 .08 .08 1</diffuse></material></visual>
